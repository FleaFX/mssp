<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>MSSP.Embedded</Title>
    <Description>Embedded single-process implementation of the MSSP event store.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSSP\MSSP.csproj" />
    <ProjectReference Include="..\MSSP.BloomFilters\MSSP.BloomFilters.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MSSP.Storage\MSSP.Storage.csproj" PrivateAssets="all" />
  </ItemGroup>


  <ItemGroup>
    <Compile Update="SubscriptionLog.FullPayloadCodec.cs">
      <DependentUpon>SubscriptionLog.cs</DependentUpon>
    </Compile>
    <Compile Update="SubscriptionLog.ReferenceOnlyCodec.cs">
      <DependentUpon>SubscriptionLog.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Bundle private implementation assemblies into the package lib folder. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);GetPrivateAssembliesForPack</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="GetPrivateAssembliesForPack" Returns="@(BuildOutputInPackage)">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)MSSP.BloomFilters.dll" Condition="Exists('$(OutputPath)MSSP.BloomFilters.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)MSSP.Storage.dll" Condition="Exists('$(OutputPath)MSSP.Storage.dll')" />
    </ItemGroup>
  </Target>

</Project>
