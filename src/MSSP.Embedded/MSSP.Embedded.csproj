<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>MSSP.Embedded</Title>
    <Authors>Wouter Naessens</Authors>
    <Product>MSSP</Product>
    <Description>Embedded single-process implementation of the MSSP event store.</Description>
    <PackageProjectUrl>https://github.com/FleaFX/mssp</PackageProjectUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSSP\MSSP.csproj" />
    <ProjectReference Include="..\MSSP.BloomFilters\MSSP.BloomFilters.csproj" />
    <ProjectReference Include="..\MSSP.Log\MSSP.Log.csproj" />
    <ProjectReference Include="..\MSSP.LsmTree\MSSP.LsmTree.csproj" />
  </ItemGroup>

</Project>
