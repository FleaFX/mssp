<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>MSSP.Embedded</Title>
    <Description>Embedded single-process implementation of the MSSP event store.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSSP\MSSP.csproj" />
    <ProjectReference Include="..\MSSP.BloomFilters\MSSP.BloomFilters.csproj" />
    <ProjectReference Include="..\MSSP.Storage\MSSP.Storage.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Compile Update="SubscriptionLog.FullPayloadCodec.cs">
      <DependentUpon>SubscriptionLog.cs</DependentUpon>
    </Compile>
    <Compile Update="SubscriptionLog.ReferenceOnlyCodec.cs">
      <DependentUpon>SubscriptionLog.cs</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
