<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>MSSP.Log</Title>
    <Authors>Wouter Naessens</Authors>
    <Product>MSSP</Product>
    <Description>Provides log structured record storage.</Description>
    <PackageProjectUrl>https://github.com/FleaFX/mssp</PackageProjectUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.7" />
  </ItemGroup>


</Project>
