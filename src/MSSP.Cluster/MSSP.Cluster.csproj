<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>$(AssemblyName)</PackageId>
    <Title>MSSP.Cluster</Title>
    <Description>HA cluster implementation of the MSSP event store using Raft consensus.</Description>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MSSP\MSSP.csproj" />
    <ProjectReference Include="..\MSSP.Embedded\MSSP.Embedded.csproj" />
    <ProjectReference Include="..\MSSP.Grpc\MSSP.Grpc.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MSSP.Raft\MSSP.Raft.csproj" PrivateAssets="all" />
    <ProjectReference Include="..\MSSP.Storage\MSSP.Storage.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\raft.proto" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MSSP.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Bundle private implementation assemblies into the package lib folder.
       MSSP.Storage.dll is intentionally omitted here: it comes bundled in MSSP.Embedded,
       which is a public dependency of MSSP.Cluster. -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);GetPrivateAssembliesForPack</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>
  <Target Name="GetPrivateAssembliesForPack" Returns="@(BuildOutputInPackage)">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)MSSP.Grpc.dll" Condition="Exists('$(OutputPath)MSSP.Grpc.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)MSSP.Raft.dll" Condition="Exists('$(OutputPath)MSSP.Raft.dll')" />
    </ItemGroup>
  </Target>

</Project>
